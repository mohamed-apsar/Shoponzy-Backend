# Copy to backend/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name, e.g. /shoponzy
MONGODB_URI=

# Frontend origins allowed to call the API with cookies (CORS + CSRF origin check)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://127.0.0.1:5176
# Optional extra origins, comma-separated (e.g. a staging site)
CORS_EXTRA_ORIGINS=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Cookies. In production: COOKIE_SECURE=true (required). Use COOKIE_SAMESITE=none only if the
# API and the sites are on different registrable domains (then COOKIE_SECURE must be true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (e.g. 1 behind Nginx / a load balancer)
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# Cloudinary (Phase 4) — keep the secret server-side only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (use test-mode keys until launch). Webhook URL to register in the Razorpay dashboard:
#   https://<api-domain>/api/v1/payments/webhook  — events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (password reset, order confirmations). Any SMTP provider: Gmail (app password), Brevo, Amazon SES, Zoho…
# Leave SMTP_HOST empty to disable email; password reset then reports that it is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shoponzy <no-reply@shoponzy.in>

# Orders & inventory
ORDER_RESERVATION_MINUTES=30
LOW_STOCK_THRESHOLD=5
# Background jobs (release unpaid reservations, clean orphaned uploads). With several API instances, enable on one only.
JOBS_ENABLED=true
